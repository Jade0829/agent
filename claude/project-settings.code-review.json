{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git fetch origin *)",
      "Bash(git worktree add --detach *)",
      "Bash(git worktree list*)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git grep *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git rev-parse *)",
      "Bash(git submodule status*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-kit-git-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
