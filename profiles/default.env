# Default profile. Copy to profiles/<name>.env (public) or profiles/local/<name>.env
# (gitignored — internal URLs, private registries) and run with --profile <name>.

# Target agent CLIs.
TOOLS="claude codex"

# Node.js: installed from NodeSource when missing or older than NODE_MIN.
NODE_MAJOR=22
NODE_MIN=20

# Pin the CLI versions (empty = install latest when missing, never touch an
# installed CLI). An exact version such as "2.1.300" is enforced: a CLI at
# another version is reinstalled at that version. A tag such as "latest" is
# used only when the CLI is missing.
CLAUDE_CODE_VERSION=""
CODEX_VERSION=""

# Extra OS packages (space separated), e.g. "sshpass podman".
EXTRA_PACKAGES=""

# MCP servers to install and register — keys of mcp/catalog.json
# (plus <profile>.mcp.json next to the selected profile and ~/.config/agent-kit/mcp.d/*.json).
MCP_SERVERS="gitlab redmine jenkins"

# Claude Code plugins: "<plugin>|<marketplace source>" (owner/repo or git URL).
CLAUDE_PLUGINS="
oh-my-claudecode|https://github.com/Yeachan-Heo/oh-my-claudecode.git
andrej-karpathy-skills|forrestchang/andrej-karpathy-skills
codex|openai/codex-plugin-cc
visual-explainer|nicobailon/visual-explainer
humanizer|blader/humanizer
"

# User-level rules (rules/global/<name>.md) → ~/.claude/CLAUDE.md and ~/.codex/AGENTS.md.
GLOBAL_RULES="communication scope evidence git git-signoff subagents ops-safety"

# Project-level rule modules (rules/modules/<name>.md) → <project>/AGENTS.md.
PROJECT_MODULES="knowledge-base code-review mr-workflow ci-jenkins multi-repo"

# Values substituted into rule text as {{NAME}}.
AGENT_LANG="Korean"
RESEARCH_DIR=".agent/research"
REVIEW_TAG_MUST="**[수정 필요]**"
REVIEW_TAG_SHOULD="**[수정 권고]**"
